{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mamabench/schemas/mamabench_v0.2.schema.json",
  "title": "mamabench v0.2 item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "set_type",
    "question",
    "choices",
    "answer",
    "answer_index",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "0.2"
    },
    "set_type": {
      "const": "mcq"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "choices": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "answer_index": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "id",
        "url",
        "license"
      ],
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
